PORT=3001
MONGO_URI=mongodb://127.0.0.1:27017/neurohaven
JWT_SECRET=replace-with-a-long-random-string-in-production
JWT_EXPIRES_IN=7d
# CORS: comma-separated browser origins. In dev, 192.168.x.x and 10.x.x.x are also allowed automatically (not in production).
# CLIENT_ORIGIN=http://localhost:5000,http://192.168.0.103:5000
CLIENT_ORIGIN=http://localhost:5000

# Optional: paste the full JSON of a Firebase service account (single line) for Google sign-in.
# Firebase Console → Project settings → Service accounts → Generate new private key
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Google Calendar + Meet (video sessions). Enable Calendar API in Google Cloud.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_CALENDAR_ID=primary
# GOOGLE_CALENDAR_IMPERSONATE_EMAIL=counselor@yourdomain.com
# MEET_LINK_FALLBACK=https://meet.google.com/new
